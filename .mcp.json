{
  "mcpServers": {
    "local-vision": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/local-vision.mjs"],
      "env": {
        "VISION_MODEL": "${VISION_MODEL:-qwen3-vl:4b}",
        "VISION_OLLAMA_HOST": "${VISION_OLLAMA_HOST:-http://127.0.0.1:11434}",
        "VISION_MAX_BYTES": "${VISION_MAX_BYTES:-20971520}",
        "VISION_TIMEOUT_MS": "${VISION_TIMEOUT_MS:-120000}",
        "VISION_KEEP_ALIVE": "${VISION_KEEP_ALIVE:-24h}",
        "VISION_MAX_OUTPUT_CHARS": "${VISION_MAX_OUTPUT_CHARS:-12000}",
        "VISION_MAX_EDGE": "${VISION_MAX_EDGE:-1280}",
        "VISION_ALLOWED_PATHS": "${VISION_ALLOWED_PATHS:-}"
      }
    }
  }
}
